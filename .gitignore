# macOS
.DS_Store

# Logs
*.log

# Dependencies
node_modules/

# Python bytecode cache
__pycache__/

# Pytest runtime cache (regenerates on next test run)
.pytest_cache/

# Skill eval workspaces (iteration outputs from skill-creator)
*-workspace/

# Loop state and mock registry (runtime only, not committed)
.claude/
# Exempt .claude/rules/ — those are project rules that should be committed
!.claude/rules/
!.claude/rules/**
settings.local.json
CLAUDE.md
vorbit_hooks.egg-info
